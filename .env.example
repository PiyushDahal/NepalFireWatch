# Free NASA FIRMS MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Optional overrides
NFW_DB_PATH=data/firewatch.sqlite
NFW_LOOKBACK_DAYS=1
NFW_CLUSTER_KM=3.0
NFW_CLUSTER_HOURS=12
NFW_MIN_CONFIDENCE=nominal

# Event lifecycle thresholds
NFW_LIFECYCLE_QUIET_HOURS=8
NFW_LIFECYCLE_CLOSED_HOURS=24
NFW_LIFECYCLE_ACTIVE_OVERPASSES=2
NFW_LIFECYCLE_PERSISTENT_OVERPASSES=3
NFW_LIFECYCLE_ACTIVE_DURATION_HOURS=1
NFW_LIFECYCLE_PERSISTENT_DURATION_HOURS=12

# Optional Sentinel-2 context imagery
NFW_S2_ENABLED=1
NFW_S2_STAC_URL=https://earth-search.aws.element84.com/v1
NFW_S2_COLLECTION=sentinel-2-l2a
NFW_S2_DAYS_BEFORE=7
NFW_S2_DAYS_AFTER=7
NFW_S2_MAX_CLOUD=60
NFW_S2_CONTEXT_KM=8
NFW_S2_IMAGE_SIZE=720
NFW_S2_RETRY_HOURS=12
NFW_S2_MAX_EVENTS_PER_RUN=3
